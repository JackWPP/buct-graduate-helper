(dd==\"\") {\n                        location.href = '/home/logout?js=xs';\n                    }\n                    else if (dd == \"dddlxx\") {\n                        location.href = '/oauthLogin/logout';\n                    }\n                    else {\n                        location.href = '/oauthLogin/logout';\n                    }\n                }\n            });\n        }\n        //初始化菜单\n        function getMenu() {\n            $.ajax({\n                type: 'get',\n                dataType: \"json\", //返回json格式的数据\n                url: \"MenuleftInfo\",\n                cache: false,\n                success: function (Data) {\n                    onIniteMenue(Data);\n                }\n            });\n        }\n        function onIniteMenue(data) {\n            var menuestr = \"\";\n            if (data && data.menus && data.menus.length > 0) {\n                $.each(data.menus, function (index, item) {\n                    var itemmenue = \"\";\n                    var icon = item.icon;\n\n                    itemmenue = \"<div class=\\\"nav\\\"><a href=\\\"javascript:void(0)\\\"><span class=\\\"\" + icon + \" icon18\\\"></span>\" + item.menuname + \"<span class=\\\"right\\\"></span></a>\";\n                    if (item.menus.length > 0) {\n                        itemmenue += \"<ul class=\\\"subnav\\\" style=\\\"display:none\\\">\";\n                        $.each(item.menus, function (index, iteminfo) {\n                            itemmenue += \"<li><a href=\\\"\" + iteminfo.url + \"\\\" target=\\\"mainFrame\\\">\" + iteminfo.menuname + \"</a></li>\";\n                        })\n                        itemmenue += \"</ul>\";\n                    }\n                    itemmenue += \"</div>\";\n                    menuestr += itemmenue;\n                });\n            }\n            else {\n                menuestr = \"<div class=\\\"nav\\\"><a href=\\\"javascript:void(0)\\\"><span class=\\\"icon-user icon18\\\"></span>个人管理<span class=\\\"right\\\"></span></a></div>\"\n                menuestr += \"<div class=\\\"nav\\\"><a href=\\\"javascript:void(0)\\\"><span class=\\\"icon-peiyang icon18\\\"></span>培养管理<span class=\\\"right\\\"></span></div>\"\n                menuestr += \"<div class=\\\"nav\\\"><a href=\\\"javascript:void(0)\\\"><span class=\\\"icon-xuewei icon18\\\"></span>毕业与学位<span class=\\\"right\\\"></span></a></div>\"\n            }\n            $(\"#nav_box\").html(menuestr);\n            addleftMenueEvent();\n        }\n        function addleftMenueEvent() {\n            $(\".nav .subnav\").prev().click(function () {\n                var classvalue = $(this).attr(\"class\");\n                var allsubnav = $(\".nav .subnav\");\n                var allnava = $(\".nav .subnav\").prev();\n                allnava.removeAttr(\"class\");\n                allsubnav.slideUp();\n                var ulobj = $(this).next();\n                if (ulobj) {\n                    if (classvalue == \"current\") {\n                        ulobj.slideUp();\n                        $(this).removeAttr(\"class\")\n                    }\n                    else {\n                        ulobj.slideDown();\n                        $(this).attr({ \"class\": \"current\" });\n                    }\n                }\n            });\n            $(\".nav .subnav a\").click(function () {\n                var currentobj = $(this);\n                $(\".nav .subnav a\").removeAttr(\"class\");\n                currentobj.attr({ \"class\": \"current\" });\n                var ejcd = currentobj.parents(\".subnav\").prev().text();\n                var sjcd = currentobj.text();\n            })\n        }\n        //个人下拉信息\n        function tagbindEvent() {\n            $(\"#nav_user_button\").click(function () {\n                var displayvalue = $(\"#userinfo\").css(\"display\");\n                if (displayvalue == \"none\") {\n                    $(\"#xjxxbtn\").unbind().click(function () {\n                        $(\"#userinfo\").css(\"display\", \"none\");\n                        $(this).attr(\"href\", \"../grgl/grjbxx\");\n                    });\n                    $(\"#xjeditbtn\").unbind().click(function () {\n                        $(\"#userinfo\").css(\"display\", \"none\");\n                        $(this).attr(\"href\", \"../grgl/grxxxg\");\n                    })\n                    $(\"#userinfo\").css(\"display\", \"\");\n\n                }\n                else {\n                    $(\"#userinfo\").css(\"display\", \"none\");\n                }\n            });\n        }\n\n        //位置定位信息\n        function frameLoad() {\n            var framesrc = document.getElementById(\"mainFrame\").contentWindow.location.pathname;\n            $.post(\"index_position\", { p: framesrc }, function (htmldata) {\n                $(\".top-left\").html(htmldata);\n            }, \"text\");\n            var framedocument = document.getElementById(\"mainFrame\").contentWindow.document;\n            var parentdocument = parent.document;\n            $(parentdocument).bind('click', documentClick);\n            $(framedocument).bind('click', documentClick);\n        }\n        function documentClick(e) {\n            var e = e || window.event;\n            var elem = e.target || e.srcElement;\n            while (elem) {\n                if (elem.className && (elem.className.indexOf('popover-photo') > -1 || elem.className.indexOf('nav-link') > -1)) {\n                    return;\n                }\n                elem = elem.parentNode;\n            }\n            parent.$('.popover-photo').css('display', 'none');\n        }\n        var intervalId = undefined;\n        function closeRbbox() {\n            $(\"#rbbox\").fadeOut(\"slow\");\n            //            setTimeInteval();\n        }\n        function SetTimeOut() {\n            setTimeout(function () {\n                unRemindTzxx();\n                unReadtzxx();\n                //                setTimeInteval();\n            }, 1000);\n        }\n        function setTimeInteval() {\n            var time = 180 * 1000;\n            intervalId = setInterval(function () {\n                try {\n                    unRemindTzxx();\n                    unReadtzxx();\n                } catch (e) {\n\n                }\n            }, time);\n        }\n        function unRemindTzxx() {\n            $.post(\"getUnRemindTzxx\", function (tzdata) {\n                if (tzdata != undefined && tzdata.length > 0) {\n                    var htmlstr = \"\";\n                    $.each(tzdata, function (index, jsonitem) {\n                        htmlstr += \"<li><a href=\\\"javascript:void(0)\\\" onclick=\\\"redirecttzgglist()\\\"><span>[最新通知]</span>\" + jsonitem.zbt + \"</a></li>\";\n                    });\n                    $(\".rbbox_list\").html(htmlstr);\n                    //                    clearInterval(intervalId);\n                    $(\"#rbbox\").slideDown(\"fast\");\n                }\n            }, \"json\");\n        }\n        function redirecttzgglist() {\n            closeRbbox();\n            var obj = $(\"#mainFrame\");\n            obj[0].src = \"../grgl/tzgglist\";\n        }\n        function unReadtzxx() {\n            $.post(\"getUnReadTzxx\", function (tzdata) {\n                if (tzdata.wdtz != \"0\") {\n                    var tzxxhtml = \"<span class=\\\"badge\\\">\" + tzdata.wdtz + \"</span>\";\n                    $(\"#tzxx\").html(tzxxhtml);\n                }\n                else {\n                    $(\"#tzxx\").html(\"\");\n                }\n                $(\"#wdzx\").html(\"[\" + tzdata.wdzx + \"]\");\n            }, \"json\");\n        }\n        function welcome() {\n            $.post(\"checkIsFisrtLogin\", function (sign) {\n                if (sign == \"0\") {\n                    var height = $(window).height() * 0.95 + \"px\";\n                    var width = $(window).width() * 0.9 + \"px\";\n                    layer.open({\n                        type: 2,\n                        title: false,\n                        area: [width, height],\n                        //skin: 'layui-layer-rim', //加上边框\n                        content: ['welcompage'],\n                        shadeClose: true,\n                        closeBtn: 1,\n                        end: function () {\n                            $.post(\"upateFirstLogin\", \"text\")\n                        }\n                    });\n                }\n\n            }, \"text\");\n        }\n    </script>\n<link type=\"text/css\" rel=\"stylesheet\" charset=\"UTF-8\" href=\"../../Scripts/google_translate/translateelement.css\"><script type=\"text/javascript\" charset=\"UTF-8\" src=\"../../Scripts/google_translate/main_zh-CN.js\"></script><script type=\"text/javascript\" charset=\"UTF-8\" src=\"../../Scripts/google_translate/element_main.js\"></script></head>\n<body style=\"position: relative; min-height: 100%; top: 0px;\">\n    <div id=\"google_translate_element\" style=\"display: none;\"><div class=\"skiptranslate goog-te-gadget\" dir=\"ltr\" style=\"\"><div id=\":0.targetLanguage\" class=\"goog-te-gadget-simple\" style=\"white-space: nowrap;\"><img src=\"../../Scripts/google_translate/cleardot.gif\" class=\"goog-te-gadget-icon\" alt=\"\" style=\"background-image: url(&quot;https://translate.googleapis.com/translate_static/img/te_ctrl3.gif&quot;); background-position: -65px 0px;\"><span style=\"vertical-align: middle;\"><a aria-haspopup=\"true\" class=\"goog-te-menu-value\" href=\"javascript:void(0)\"><span>chose language</span><img src=\"../../Scripts/google_translate/cleardot.gif\" alt=\"\" width=\"1\" height=\"1\"><span style=\"border-left: 1px solid rgb(187, 187, 187);\">​</span><img src=\"../../Scripts/google_translate/cleardot.gif\" alt=\"\" width=\"1\" height=\"1\"><span aria-hidden=\"true\" style=\"color: rgb(118, 118, 118);\">▼</span></a></span></div></div></div>\n    <div class=\"page\">\n        <header>\n   