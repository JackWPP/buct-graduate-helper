{
  "url": "https://gmis.buct.edu.cn/home/login",
  "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\"><html xmlns=\"http://www.w3.org/1999/xhtml\"><head>\n    <meta name=\"renderer\" content=\"webkit|ie-comp|ie-stand\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge, chrome=1\">\n    \n    \n    <title>研究生管理信息系统登录</title>\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/Content/themes/gray/login.css\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/Content/themes/gray/easyui.css\">\n    \n    <script type=\"text/javascript\" src=\"/Scripts/jquery.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/Scripts/jsencrypt.min.js\"></script>\n    <script type=\"text/javascript\" src=\"/Scripts/json2.js\"></script>\n    <script type=\"text/javascript\" src=\"/Scripts/jquery.easyui.min.js\"></script>\n    \n    <script src=\"http://pv.sohu.com/cityjson\"></script>\n    <script>\n        var p = window;\n        if (p != p.parent) {\n            p = p.parent;\n            p.location.href = document.URL;\n        }\n    </script>\n</head>\n\n<body>\n    <div class=\"loginlogo\">\n        <div class=\"logo\"><img src=\"../images/loginlogo.png\"></div>\n        <div class=\"logo-word\">\n            研究生管理信息系统\n            <span class=\"EN\">Graduate Management Information System</span>\n        </div>\n    </div>\n    <div class=\"layout1\">\n        <form id=\"ff\">\n            <input id=\"hfcity\" type=\"hidden\" name=\"city\" style=\"\">\n            <input id=\"hfgoto\" type=\"hidden\" style=\"\">\n            <div class=\"loginlayout\">\n                <div class=\"from\">\n                    <div class=\"from-group\">\n                        <label class=\"label\">工号</label>\n                        <input type=\"text\" class=\"inputtext\" id=\"UserId\" name=\"UserId\" placeholder=\"请输入教师工号\" style=\"width: 200px;\">\n                    </div>\n                    <div class=\"from-group\">\n                        <label class=\"label\">密码</label>\n                        <input type=\"password\" class=\"inputtext\" id=\"Password\" name=\"Password\" placeholder=\"请输入密码\" style=\"width: 200px;\">\n                    </div>\n                    <div class=\"from-group\">\n                        <input type=\"text\" class=\"inputtext width160\" id=\"VeriCode\" name=\"VeriCode\" placeholder=\"请输入验证码\" style=\"\">\n                        <img id=\"imgVerifi\" title=\"单击换一张验证码\" class=\"inputimage\" src=\"/Home/VerificationCode?t=55\" onclick=\"changecode()\">\n                    </div>\n                    <div class=\"from-group\">\n                        <a class=\"links-word\" href=\"forgotpwd\">忘记密码？</a>\n                    </div>\n                    <div class=\"from-group\">\n                        <button id=\"btnlogin\" class=\"btn\" onclick=\"loginform();return false\">登录</button>\n                    </div>\n                </div>\n                <div class=\"from-info\">\n                    <div class=\"icon\">\n                        <ul>\n                            <li>\n                                <span><img src=\"../images/icon1.png\"></span>\n                                <span>云智能 慧感知 优服务</span>\n                            </li>\n                            <li>\n                                <span><img src=\"../images/icon2.png\"></span>\n                                <span>流程化 规范化 一体化</span>\n                            </li>\n                            <li>\n                                <span><img src=\"../images/icon3.png\"></span>\n                                <span>轻办公 高效率 全过程</span>\n                            </li>\n                        </ul>\n                        <div class=\"clear\"></div>\n                    </div>\n                    <div class=\"tip\">\n                        <div class=\"tip-title\">友情提示</div>\n                        <p>教师及管理人员用户用工号或管理员账号和密码登录系统。</p>\n                    </div>\n                </div>\n            </div>\n        </form>\n        <div class=\"footer\">\n            <p>说明：1.使用chrome或IE10+浏览器（360浏览器版本8.1以上）  2.1280*800分辨率以上浏览本系统  3.请不要屏蔽弹出窗口  4.技术支持：南京南软(版本:5.0)</p>\n        </div>\n    </div>\n    <input id=\"pubkey\" type=\"hidden\" value=\"-----BEGIN PUBLIC KEY-----\nMIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCnDNsXcT5qksMZ7fYE3lhPa9UR\nviCbQvIb6FijkcQGSlbl+eIs02Kwxkc57WehI7JpK3CE0Kvyfo9t8NLusxsUYRvO\nMrleilH0xp27B9fdJ04wu67N9UtaJO4l0rWLEaP8UjnxUbfcdl0TjJweGRiKGvON\nuG4hLbpFav3QV8+hMwIDAQAB\n-----END PUBLIC KEY-----\n\" style=\"\">\n    \n\n\n\n<script type=\"text/javascript\">\n    var groups = \"\";\n    $(function () {\n        groups = \"\";\n        getcity();\n//        var userid = '';\n//        alert(userid);\n    });\n    function getcity() {\n        //        var province = returnCitySN.province;\n        var city = returnCitySN.cname;\n        $(\"#hfcity\").val(city);\n    }\n    function loginform() {\n        $(\"#btnlogin\").attr(\"disabled\", \"disabled\");\n        var info = new Object();\n        info.UserId = $(\"#UserId\").val();\n        var p = $(\"#Password\").val();\n        var rsa = new JSEncrypt();\n        var pubkey = $(\"#pubkey\").val();\n        rsa.setPublicKey(pubkey);\n        var rsa_p = rsa.encrypt(p);\n        info.Password = rsa_p;\n        info.VeriCode = $(\"#VeriCode\").val();\n        info.city = $(\"#hfcity\").val();\n        info.url = $(\"#hfgoto\").val();\n        var jsonObject = JSON.stringify(info);\n        $.ajax({\n            type: 'post',\n            url: \"login_do\",\n            dataType: \"json\", //返回json格式的数据\n            data: { 'json': jsonObject },\n            cache: false,\n            success: function (data) {\n                if (data.jg == \"1\") {\n                    document.location = \"../\" + data.url;\n                }\n                else if (data.jg == \"2\") {\n                    var grouphtml = '';\n                    $.each(data.group, function (i, o) {\n                        grouphtml += '<div style=\"padding-left:50px; padding-top:10px;\">';\n                        if (i == 0) {\n                            grouphtml += '<input id=\"' + o.groupcode + '\" type=\"radio\" name=\"rdogroup\" value=\"' + o.groupcode + '\" checked=\"checked\"/>';\n                        } else {\n                            grouphtml += '<input id=\"' + o.groupcode + '\" type=\"radio\" name=\"rdogroup\" value=\"' + o.groupcode + '\"/>';\n                        }\n                        grouphtml += '<label for=\"' + o.groupcode + '\">' + o.groupdesc + '</label></div>';\n                    });\n                    $(\"#groupbox\").html(grouphtml);\n                    show_grouplist();\n                }\n                else {\n                    $('#imgVerifi').attr('src', '/Home/VerificationCode' + '?t=' + new Date().getSeconds());\n                    $.messager.alert(\"提示\", data.msg, \"error\");\n                }\n                $(\"#btnlogin\").attr(\"disabled\", false);\n            },\n            error: function (e) {\n                var msg = responseTextTitle(e.responseText);\n                $.messager.alert(\"提示\", msg, \"error\");\n            }\n        });\n    }\n    window.onkeypress = function () {\n        if (event.keyCode == 13) {\n            if (groups == \"1\") {\n                document.getElementById('btn_groupok').click();\n            }\n        }\n    }\n    function changecode() {\n        $('#imgVerifi').attr('src', '/Home/VerificationCode' + '?t=' + new Date().getTime());\n    }\n\n    function show_grouplist() {\n        groups = \"1\";\n        $(\"#w_group\").window({\n            modal: true,\n            width: 400,\n            height: 'auto'\n        });\n        $('#w_group').window('open');\n        $(\"#w_group\").window('center');\n    }\n\n    function sel_group() {\n        var group = $('input:radio[name=rdogroup]:checked').val();\n        $.ajax({\n            type: 'get',\n            dataType: 'json',\n            url: 'index_selgroup',\n            data: { 'group': group },\n            cache: false,\n            success: function (data) {\n                if (data.zt == \"1\") {\n                    document.location = '/home/index';\n                }\n                else {\n                    $.messager.alert(\"提示\", data.msg);\n                }\n            }\n        });\n    }\n    function responseTextTitle(responseText) {\n        var index1 = responseText.indexOf(\"<title>\");\n        var index2 = responseText.indexOf(\"</title>\");\n        return responseText.substring(index1 + 7, index2);\n    }\n</script>\n<div class=\"panel window\" style=\"display: none; left: 584px; top: 318px;\"><div class=\"panel-header panel-header-noborder window-header\" style=\"width: 70px;\"><div class=\"panel-title\">请选择角色</div><div class=\"panel-tool\"><a class=\"panel-tool-close\" href=\"javascript:void(0)\"></a></div></div><div id=\"w_group\" class=\"easyui-window panel-body panel-body-noborder window-body\" title=\"\" data-options=\"cache:false,closed:true,collapsible:false,minimizable:false,maximizable:false\" style=\"width: 90px;\">\n        <div id=\"groupbox\" style=\"height:100px;\">\n\n        </div>\n        <div style=\"text-align:right; position:absolute; bottom:10px;right:20px\">\n            <button class=\"login-btn-primary\" type=\"button\" id=\"btn_groupok\" onclick=\"sel_group()\">确定</button>\n            <button class=\"login-btn-primary\" type=\"button\" onclick=\"$('#w_group').window('close')\">取消</button>\n        </div>\n    </div></div><div class=\"window-shadow\" style=\"display: none; left: 584px; top: 318px;\"></div><div class=\"panel window messager-window\" style=\"display: block; width: 298px; left: 490px; top: 329px; z-index: 9002;\"><div class=\"panel-header panel-header-noborder window-header\" style=\"width: 258px;\"><div class=\"panel-title\">提示</div><div class=\"panel-tool\"><a class=\"panel-tool-close\" href=\"javascript:void(0)\"></a></div></div><div class=\"messager-body panel-body panel-body-noborder window-body\" title=\"\" style=\"width: 278px;\"><div class=\"messager-icon messager-error\"></div><div>用户名不存在</div><div style=\"clear:both;\"></div><div class=\"messager-button\"><a href=\"javascript:void(0)\" class=\"l-btn l-btn-small l-btn-focus\" group=\"\" id=\"\" style=\"margin-left: 10px;\"><span class=\"l-btn-left\"><span class=\"l-btn-text\">Ok</span></span></a></div></div></div><div class=\"window-shadow\" style=\"display: block; left: 490px; top: 329px; z-index: 9001; width: 300px; height: 142px;\"></div><div class=\"window-mask\" style=\"width: 1280px; height: 800px; display: block; z-index: 9000;\"></div></body></html>"
}