# 复制为 app/android/key.properties 后填写，不要提交 key.properties 或 keystore。
# 生成自己的 keystore：
#   keytool -genkeypair -v -keystore ~/huayan-release.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias huayan
storeFile=/absolute/path/to/huayan-release.jks
storePassword=change-me
keyAlias=huayan
keyPassword=change-me
